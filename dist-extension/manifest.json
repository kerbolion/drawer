{
  "manifest_version": 3,
  "name": "Convierte Google Sheets en un CRM",
  "version": "0.11.0",
  "description": "Organiza y gestiona tus datos de Google Sheets como un CRM.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "http://127.0.0.1:17373/*",
    "https://abrircrm.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/spreadsheets/d/*"],
      "js": ["page-write.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://docs.google.com/spreadsheets/d/*"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ]
}
