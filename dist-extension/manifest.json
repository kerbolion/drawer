{
  "manifest_version": 3,
  "name": "Sheets Row Drawer",
  "version": "0.11.0",
  "description": "Gestiona filas, relaciones, Kanban y calendario usando la sesión abierta de Google Sheets.",
  "permissions": ["storage"],
  "host_permissions": [
    "http://127.0.0.1:17373/*",
    "https://solode.click/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/spreadsheets/d/*"],
      "js": ["page-write.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://docs.google.com/spreadsheets/d/*"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ]
}
